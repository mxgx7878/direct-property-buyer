RewriteEngine On

# Force HTTPS and WWW
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.directpropertybuyer\.com\.au$ [NC]
RewriteRule ^ https://www.directpropertybuyer.com.au%{REQUEST_URI} [R=301,L]

# Remove index.php from the homepage URL
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]|$) [NC]
RewriteRule ^index\.php$ https://www.directpropertybuyer.com.au/ [R=301,L,NE]